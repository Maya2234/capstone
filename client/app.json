{
  "expo": {
    "name": "CardMaxx",
    "slug": "cardmaxx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardmaxx",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F2FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardmaxx.app"
    },
    "android": {
      "package": "com.cardmaxx.app",
      "adaptiveIcon": {
        "backgroundColor": "#ECEBF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "name": "CardMaxx",
      "themeColor": "#4039DF"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://localhost:8081"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#110E24",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CardMaxx uses your photos so you can pick a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
