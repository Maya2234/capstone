# Copy to .env and fill in. Never commit .env.
# Values without EXPO_PUBLIC_ stay on the server (API routes) and never reach the app bundle.

# Help > Contact form (https://resend.com/api-keys)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Until you verify a domain in Resend, use their test sender:
CONTACT_FROM_EMAIL=CardMaxx Support <onboarding@resend.dev>

# Plaid (see PLAID.md). Leave blank to keep demo mode.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Supabase (Project Settings > API Keys). Use the publishable key, never the secret one.
# Then run supabase/schema.sql once in the dashboard's SQL Editor.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Server only (no EXPO_PUBLIC_): lets API routes save Plaid tokens. Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_KEY=
