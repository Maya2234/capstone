# Copy to .env and fill in. Never commit .env.
# Values without EXPO_PUBLIC_ stay on the server (API routes) and never reach the app bundle.

# Help > Contact form (https://resend.com/api-keys)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Until you verify a domain in Resend, use their test sender:
CONTACT_FROM_EMAIL=CardMaxx Support <onboarding@resend.dev>

# Plaid (see PLAID.md). Leave blank to keep demo mode.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
